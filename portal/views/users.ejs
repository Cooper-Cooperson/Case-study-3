<!DOCTYPE html>
<html>
<head>
  <title>Users List</title>
  <style>
    body { font-family: Arial; margin: 40px; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    th, td { padding: 10px; border-bottom: 1px solid #ccc; text-align: left; }
    th { background: #f0f0f0; }
    a { text-decoration: none; color: #007bff; }
  </style>
</head>
<body>

  <h1>Users List</h1>
  <p><a href="/">← Back to New Hire Form</a></p>

  <table>
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Email</th>
      <th>Department</th>
      <th>Role</th>
      <th>Status</th>
      <th>Created</th>
    </tr>

    <% users.forEach(user => { %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.department %></td>
        <td><%= user.role %></td>
        <td><%= user.status %></td>
        <td><%= user.created_at.toISOString().slice(0, 19).replace("T", " ") %></td>
      </tr>
    <% }) %>

  </table>

</body>
</html>